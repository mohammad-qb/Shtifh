generator client {
  provider = "prisma-client-js"
}

generator jsonTypes {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Accessory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  price     Float
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model Agent {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  position           Int[]
  salary             Float
  color              String
  start_work_date    DateTime
  is_available       Boolean              @default(true)
  is_busy            Boolean              @default(false)
  coordinates        Float[] // lat and lon
  /// [AgentWalletSummaryJson]
  wallet_summary     Json // {total_tips: 0, total_orders_earn: 0}
  user               User                 @relation(fields: [userId], references: [id])
  userId             String               @db.ObjectId
  carOrders          CarOrder[]
  ExpressCrWashOrder ExpressCrWashOrder[]
}

model BookedSlot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  date       String // "2024-10-02"
  time       String
  carOrder   CarOrder @relation(fields: [carOrderId], references: [id])
  carOrderId String   @db.ObjectId
}

model Customer {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  image_url          String
  gender             Int
  is_removed         Boolean              @default(false)
  user               User                 @relation(fields: [userId], references: [id])
  userId             String               @db.ObjectId
  cars               Car[]
  carOrders          CarOrder[]
  ExpressCrWashOrder ExpressCrWashOrder[]
}

model Car {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  plate_number       String
  year               Int
  color              String
  is_active          Boolean              @default(true)
  brand              CarBrand             @relation(fields: [carBrandId], references: [id])
  model              CarModel             @relation(fields: [carModelId], references: [id])
  customer           Customer             @relation(fields: [customerId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt()
  customerId         String               @db.ObjectId
  carBrandId         String               @db.ObjectId
  carModelId         String               @db.ObjectId
  carOrders          CarOrder[]
  ExpressCrWashOrder ExpressCrWashOrder[]
}

model CarBrand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  cars      Car[]
}

model CarModel {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  cars      Car[]
}

model City {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name               Json // {ar: "", en: "", he: ""}
  is_active          Boolean    @default(true)
  /// [CityScheduleJson]
  schedule           Json // {global: {start_time: "", end_time: "", request_in_hour: 0, is_off: false}, recurring: {start_time: "", end_time: "", day: Day, request_in_hour: 0, is_off: false}, monthly: {month: 0, year: 0, start_time: "09:00", end_time: "16:00", requests_in_hour: 0, is_off: false}, daily: {start_time: "09:00", end_time: "16:00", requests_in_hour: 0, is_off: false, date: ""}}
  /// [CityCarModelServiceJson]
  car_model_services Json[] // {carModelId: "", serviceId: "", fees: 0, is_active: true}
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt()
  carOrders          CarOrder[]
}

model CarOrder {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  ref_number  String
  order_date  DateTime?
  order_time  String?
  fees        Float
  tips        Float
  note        String?
  address     String
  /// [CarOrderLogJson]
  logs        Json[] // {status: CarOrderLogStatus, createdAt: DateTime}
  /// [CarOrderAccessoriesJson]
  accessories Json[] // {accessoryId: "", quantity: 0}
  type        Int          @default(0)
  service     Service      @relation(fields: [serviceId], references: [id])
  car         Car          @relation(fields: [carId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  agent       Agent?       @relation(fields: [agentId], references: [id])
  city        City         @relation(fields: [cityId], references: [id])
  coordinates Float[] // lat and lon
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt()
  carId       String       @db.ObjectId
  customerId  String       @db.ObjectId
  cityId      String       @db.ObjectId
  serviceId   String       @db.ObjectId
  agentId     String?      @db.ObjectId
  payments    Payment[]
  bookedSlots BookedSlot[]
}

model ExpressCrWashOrder {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  ref_number  String
  fees        Float
  tips        Float
  /// [CarOrderLogJson]
  logs        Json[] // {status: CarOrderLogStatus, createdAt: DateTime}
  car         Car       @relation(fields: [carId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])
  agent       Agent?    @relation(fields: [agentId], references: [id])
  coordinates Float[] // lat and lon
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  carId       String    @db.ObjectId
  customerId  String    @db.ObjectId
  agentId     String?   @db.ObjectId
  payments    Payment[]
}

model Payment {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  payment_method       Int                 @default(1)
  amount               Float
  transaction_id       String?
  status               Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt()
  CarOrder             CarOrder?           @relation(fields: [carOrderId], references: [id])
  carOrderId           String?             @db.ObjectId
  ExpressCrWashOrder   ExpressCrWashOrder? @relation(fields: [expressCrWashOrderId], references: [id])
  expressCrWashOrderId String?             @db.ObjectId
}

model Service {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  type      Int        @default(1)
  image_url String?
  is_active Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt()
  CarOrder  CarOrder[]
}

model User {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  full_name           String
  email               String     @unique
  phone               String
  password            String
  is_blocked          Boolean    @default(false)
  language            Int        @default(0)
  reset_password_code String?
  role                Int        @default(1)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt()
  agent               Agent[]
  customers           Customer[]
}

//* Enums

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
}
