generator client {
  provider = "prisma-client-js"
}

generator jsonTypes {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
  output    = "./prisma-json-type.d.ts"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Accessory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  price     Float
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
}

model BookedSlot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  date       String // "2024-10-02"
  time       String
  carOrder   CarOrder @relation(fields: [carOrderId], references: [id])
  carOrderId String   @db.ObjectId
}

model Customer {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  image_url  String
  gender     Gender
  is_removed Boolean    @default(false)
  user       User       @relation(fields: [userId], references: [id])
  userId     String     @db.ObjectId
  cars       Car[]
  carOrders  CarOrder[]
}

model Car {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  plate_number String
  year         Int
  color        String
  is_active    Boolean    @default(true)
  brand        CarBrand   @relation(fields: [carBrandId], references: [id])
  model        CarModel   @relation(fields: [carModelId], references: [id])
  customer     Customer   @relation(fields: [customerId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()
  customerId   String     @db.ObjectId
  carBrandId   String     @db.ObjectId
  carModelId   String     @db.ObjectId
  carOrders    CarOrder[]
}

model CarBrand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  cars      Car[]
}

model CarModel {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name      Json // {ar: "", en: "", he: ""}
  image_url String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  cars      Car[]
}

model CarOrder {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  ref_number   String
  status       OrderStatus  @default(PENDING)
  order_date   DateTime?
  order_time   String?
  fees         Float
  tips         Float
  note         String?
  address      String
  type         OrderType    @default(NORMAL)
  car          Car          @relation(fields: [carId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  city         City         @relation(fields: [cityId], references: [id])
  car_location String[] // lat and lon
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt()
  carId        String       @db.ObjectId
  customerId   String       @db.ObjectId
  employeeId   String       @db.ObjectId
  cityId       String       @db.ObjectId
  payments     Payment[]
  bookedSlots  BookedSlot[]
}

model City {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  /// [NameJson]
  name               Json // {ar: "", en: "", he: ""}
  is_active          Boolean    @default(true)
  /// [CityScheduleJson]
  schedule           Json // {global: {start_time: "", end_time: "", request_in_hour: 0, is_off: false}, recurring: {start_time: "", end_time: "", day: Day, request_in_hour: 0, is_off: false}, monthly: {month: 0, year: 0, start_time: "09:00", end_time: "16:00", requests_in_hour: 0, is_off: false}, daily: {start_time: "09:00", end_time: "16:00", requests_in_hour: 0, is_off: false, date: ""}}
  /// [CityCarModelServiceJson]
  car_model_services Json[] // {carModelId: "", serviceId: "", fees: 0, is_active: true}
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt()
  carOrders          CarOrder[]
}

model Employee {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  position        String
  salary          Float
  color           String
  start_work_date DateTime
  /// [EmployeeWalletSummaryJson]
  wallet_summary  Json // {total_tips: 0, total_orders_earn: 0}
  user            User       @relation(fields: [userId], references: [id])
  userId          String     @db.ObjectId
  carOrders       CarOrder[]
}

model Payment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  payment_method PaymentMethod @default(CREDIT_CARD)
  amount         Float
  transaction_id String?
  status         PaymentStatus @default(PENDING)
  carOrder       CarOrder      @relation(fields: [carOrderId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt()
  carOrderId     String        @db.ObjectId
}

model User {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  full_name           String
  email               String     @unique
  phone               String
  password            String
  is_blocked          Boolean    @default(false)
  language            Lang       @default(EN)
  reset_password_code String?
  role                UserRole   @default(CUSTOMER)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt()
  employees           Employee[]
  customers           Customer[]
}

//* Enums
enum Lang {
  EN
  AR
  HE
}

enum UserRole {
  ADMIN
  CUSTOMER
  EMPLOYEE
}

enum ServiceType {
  PRIVATE
  PUBLIC
}

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CONFIRMED
  CANCELED
}

enum OrderType {
  PRIVATE
  NORMAL
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum Day {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
}

